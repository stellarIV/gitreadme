# gitreadme (RepoIntel / ReadMyRepo) — Environment Configuration
# Copy this file to .env.local and fill in the values you need.
# The app works with ZERO env vars set — the heuristic engine and
# offline fallbacks handle everything gracefully.

# ============================================================
# 1. GitHub API Configuration
# ============================================================
# Optional personal access token (increases rate limit 60 → 5,000 req/hr)
# Required for private-repo analysis.
GITHUB_TOKEN=ghp_your_personal_access_token_here

# For enterprise GitHub App installation (optional, higher rate limits):
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=

# ============================================================
# 2. AI Model Providers (all optional)
# ============================================================
# The system falls back to the offline Heuristic Analyzer when no AI
# key is present — zero external dependencies, zero required setup.

# Google Gemini (Gemini 2.0 Flash / Pro recommended)
GEMINI_API_KEY=AIzaSy...

# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=sk-...

# Anthropic Claude (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=sk-ant-...

# Local Ollama endpoint (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# 3. Security & Encryption
# ============================================================
# AES-256-GCM encryption key for stored GitHub OAuth tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED for encrypted token storage (gracefully skips encryption if absent).
ENCRYPTION_SECRET=change_me_to_a_64_char_hex_string_generated_randomly

# ============================================================
# 4. GitHub Webhooks
# ============================================================
# Secret used to verify HMAC-SHA256 webhook signatures from GitHub.
# Set this in your GitHub repo → Settings → Webhooks → Secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED for webhook signature verification (skips verification if absent).
GITHUB_WEBHOOK_SECRET=change_me_to_a_random_webhook_secret

# Webhook URL to register in GitHub:
#   https://your-domain.com/api/webhooks/github
# Recommended content type: application/json
# Events to subscribe: push, pull_request

# ============================================================
# 5. Application Settings
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used by webhook background re-analysis to call /api/analyze internally.
# Set to your production URL in deployment.
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================================
# 6. Redis (optional — for distributed quota tracking at scale)
# ============================================================
# When set, quotaManager will use Redis instead of the local file store.
# REDIS_URL=redis://localhost:6379
